{
  "name": "sjccc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build && vite build --config vite.sw.config.ts && tsx scripts/postbuild.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "audit": "tsx scripts/audit/runAudit.ts",
    "inspect": "tsx scripts/inspect/inspectBundle.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "cheerio": "^1.2.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@kennejunior/liquidglass": "^1.0.5",
    "qrcode": "^1.5.4",
    "vercel": "^62.2.0"
  }
}
